# ==============================================================================
# CONFIGURACIÓN PARA DESPLIEGUE EN RENDER / RAILWAY / LOCAL
# CENTRO ODONTOLÓGICO ODONTOMAX
# ==============================================================================

# Puerto del Servidor (Render lo asigna dinámicamente)
PORT=8080

# Conexión Supabase PostgreSQL (Transaction Pooler - Puerto 6543 con prepareThreshold=0)
SUPABASE_DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SUPABASE_DB_USER=postgres.tu-proyecto-id
SUPABASE_DB_PASSWORD=tu-contrasena-supabase

# Firma Criptográfica de Tokens JWT (Mínimo 64 caracteres criptográficos - generar con: openssl rand -base64 48)
JWT_SECRET=GENERAR_CON_OPENSSL_RAND_BASE64_48_NO_USAR_VALORES_PREDETERMINADOS

# Clave Maestra de Cifrado AES-256-GCM para 2FA TOTP en Reposo (Obligatoria: 32 bytes Base64 - generar con: openssl rand -base64 32)
TOTP_ENCRYPTION_KEY=GENERAR_CON_OPENSSL_RAND_BASE64_32_OBLIGATORIA
# Clave previa opcional para rotación de secretos TOTP (Descomentar al rotar)
# TOTP_ENCRYPTION_KEY_OLD=

# Almacenamiento Seguro de Radiografías en Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=tu-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY=tu-r2-access-key-id
CLOUDFLARE_R2_SECRET_KEY=tu-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=radiografias-odontomax
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://radiografias.odontomax.pe

# Dominios Autorizados para CORS (Separados por coma, sin comodines amplios)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://odontomax.pe,https://tu-app.vercel.app

# Correo SMTP para recuperación de contraseña (sin SPRING_MAIL_HOST la recuperación queda deshabilitada en producción)
# Ejemplo Gmail: host smtp.gmail.com, puerto 587 y una "contraseña de aplicación" (no la contraseña normal)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=notificaciones@odontomax.pe
SPRING_MAIL_PASSWORD=tu-contrasena-de-aplicacion-smtp
APP_MAIL_FROM=notificaciones@odontomax.pe
# URL pública del frontend (el enlace del correo apunta a <APP_FRONTEND_URL>/restablecer-password)
APP_FRONTEND_URL=https://odontomax.pe
